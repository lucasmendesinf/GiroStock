NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://girostock:girostock@postgres:5432/girostock
# Banco do Modo teste (outro banco, mesma estrutura). Ausente ou igual a DATABASE_URL = modo teste indisponivel.
DATABASE_URL_TESTE=postgres://girostock:girostock@postgres:5432/girostock_teste
# Alternativa curta (hospedagem): so o NOME do banco de teste; usa o mesmo servidor/usuario/senha da DATABASE_URL.
# DATABASE_NOME_TESTE=calutecc_girostock_teste
REDIS_URL=redis://redis:6379

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h

# Chave que cifra os segredos do 2FA (AES-256-GCM): 32 bytes em base64 ou 64 caracteres hexadecimais.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em producao, sem ela o 2FA fica indisponivel (nunca grava segredo em texto puro). Nao perca esta chave: sem ela os 2FA ativos deixam de funcionar.
TOTP_ENC_KEY=
