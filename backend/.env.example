NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://girostock:girostock@postgres:5432/girostock
# Banco do Modo teste (outro banco, mesma estrutura). Ausente ou igual a DATABASE_URL = modo teste indisponivel.
DATABASE_URL_TESTE=postgres://girostock:girostock@postgres:5432/girostock_teste
# Alternativa curta (hospedagem): so o NOME do banco de teste; usa o mesmo servidor/usuario/senha da DATABASE_URL.
# DATABASE_NOME_TESTE=calutecc_girostock_teste
REDIS_URL=redis://redis:6379

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h

# Chave que cifra os segredos do 2FA (AES-256-GCM): 32 bytes em base64 ou 64 caracteres hexadecimais.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em producao, sem ela o 2FA fica indisponivel (nunca grava segredo em texto puro). Nao perca esta chave: sem ela os 2FA ativos deixam de funcionar.
TOTP_ENC_KEY=

# iFood (modulo "iFood e 99Food"): credenciais do APP da Calutec no Portal do Desenvolvedor iFood (app distribuido).
# Sem elas a integracao fica desligada. Cada loja conecta a sua conta em Lojas & PDVs.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Opcional: so para o simulador local (npm run ifood:simulador). Em producao, deixe em branco.
# IFOOD_API_URL=http://localhost:4999
# IFOOD_POLLING_SEGUNDOS=2
# IFOOD_POLLING=desligado

# 99Food (mesmo modulo): app_id e app_secret do APP da Calutec no portal de desenvolvedores da 99Food.
# No cadastro do app, informe o webhook: https://SEU-DOMINIO/api/webhooks/99food
FOOD99_APP_ID=
FOOD99_APP_SECRET=
# Opcional: so para o simulador local (npm run food99:simulador). Em producao, deixe em branco.
# FOOD99_API_URL=http://localhost:4998/v1

# Loja virtual: endereco publico deste servidor (links das fotos e aviso de pagamento do Mercado Pago).
# Ex.: https://sistema.girostock.com.br  (vazio = o endereco da propria requisicao)
URL_PUBLICA=
# E-mail (codigo de recuperacao de senha dos clientes do site). No cPanel: o servidor de e-mail da hospedagem.
# Sem SMTP em producao, a recuperacao por e-mail fica indisponivel. Fora da producao, os e-mails vao para backend/tmp/emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Opcional: so para o simulador local do Mercado Pago (npm run mp:simulador). Em producao, deixe em branco.
# Cada empresa cadastra as PROPRIAS credenciais do Mercado Pago na tela Loja virtual > Pagamentos.
# MP_API_URL=http://localhost:4997
# LOJA_VARREDURA_SEGUNDOS=2
